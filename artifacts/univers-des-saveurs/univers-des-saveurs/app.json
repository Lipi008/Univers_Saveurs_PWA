{
  "expo": {
    "name": "L'Univers des Saveurs",
    "slug": "univers-des-saveurs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "univers-des-saveurs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png",
      "name": "L'Univers des Saveurs",
      "shortName": "Univers Saveurs",
      "themeColor": "#7B2430",
      "backgroundColor": "#F8F3EA",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
